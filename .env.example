# Copy to .env and fill in. Not required to run main.py — if ANTHROPIC_API_KEY
# is unset, the Agent SDK falls back to the locally authenticated `claude` CLI.
ANTHROPIC_API_KEY=

# Optional. Leave both unset to run without tracing (main.py degrades gracefully).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Required for notion_main.py. Create an internal integration at
# https://www.notion.so/my-integrations, share your "Agent Access" page with
# it, and paste that page's ID here. See tasks/02-notion-integration.md.
NOTION_TOKEN=
NOTION_ROOT_PAGE_ID=

# Required for github_main.py. A GitHub App token or classic/fine-grained
# PAT with repo/issues/PR scopes — used as a Bearer token against GitHub's
# hosted remote MCP server. See tasks/03-github-integration.md.
GITHUB_TOKEN=
GITHUB_TEST_REPO=octocat/Hello-World

# Required for agent_main.py's Gmail, Drive, Calendar, and YouTube tools
# (they share one Google OAuth client). Create a Desktop app OAuth client at
# https://console.cloud.google.com/apis/credentials and enable the Gmail,
# Drive, Calendar, and YouTube Data APIs on that project. First run opens a
# browser for consent; the token is cached afterward. See
# tasks/06-remaining-integrations.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required for agent_main.py's Spotify tools. Create an app at
# https://developer.spotify.com/dashboard and add the redirect URI below
# (or your own) to it. First run opens a browser for consent; the token is
# cached afterward. See tasks/06-remaining-integrations.md.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Dev/staging mode (TRD §15): "dev" or "staging" auto-approves write and
# destructive tool calls instead of blocking on a confirmation prompt.
# Defaults to "prod" (always ask) — opt into the looser mode explicitly.
AGENT_MODE=prod

# Daily spend cap in USD, enforced by agent_main.py before each turn.
DAILY_SPEND_CAP_USD=5.00
